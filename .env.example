# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documents
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5

# LLM settings
# Available models: claude-3-5-sonnet-20241022, claude-3-sonnet-20240229, claude-3-haiku-20240307
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Embedding settings
# Available: voyage-large-2 (1536 dims), voyage-2 (1024 dims)
EMBEDDING_MODEL=voyage-large-2
EMBEDDING_DIMENSIONS=1536

# Vector store
VECTOR_SIMILARITY_THRESHOLD=0.75
VECTOR_TOP_K=5

# Ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=50

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
