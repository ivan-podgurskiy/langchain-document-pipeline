# Anthropic API (Claude, LLM)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Voyage AI API (embeddings; get key at voyage.ai)
VOYAGE_API_KEY=your_voyage_api_key_here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/documents
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5

# LLM settings
# Available models: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Embedding settings
# Available: voyage-large-2 (1536 dims), voyage-2 (1024 dims)
EMBEDDING_MODEL=voyage-large-2
EMBEDDING_DIMENSIONS=1536

# Vector store
VECTOR_SIMILARITY_THRESHOLD=0.5
VECTOR_TOP_K=5

# Ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=50
# Directory to store original PDF files (for document viewer)
DOCUMENT_STORAGE_PATH=./data/documents

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
