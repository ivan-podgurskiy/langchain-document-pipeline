{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "schedule": ["before 6am on monday"],
  "semanticCommits": "enabled",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Security updates run immediately",
      "matchCategories": ["security"],
      "schedule": ["at any time"],
      "labels": ["security"]
    },
    {
      "description": "Group Python production dependencies",
      "matchManagers": ["pep621", "pip_requirements", "pip_setup"],
      "matchDepTypes": ["dependencies", "requirement"],
      "groupName": "python dependencies"
    },
    {
      "description": "Group Python dev dependencies",
      "matchManagers": ["pep621", "pip_requirements", "pip_setup"],
      "matchDepTypes": ["devDependencies", "dev", "development"],
      "groupName": "python dev dependencies"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Docker base images",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker"
    }
  ]
}
